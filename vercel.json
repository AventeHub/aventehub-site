{
 "cleanUrls": true,
 "trailingSlash": true,
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    },
    {
     "key": "Permissions-Policy",
     "value": "camera=(), microphone=(), geolocation=()"
    },
    {
     "key": "X-Frame-Options",
     "value": "SAMEORIGIN"
    }
   ]
  },
  {
   "source": "/(.*)/m/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  },
  {
   "source": "/media/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  }
 ],
 "functions": {
  "api/wa-media.js": {
   "maxDuration": 60
  },
  "api/wa-upload.js": {
   "maxDuration": 60
  },
  "api/wa-webhook.js": {
   "maxDuration": 30
  },
  "api/wa-outbox.js": {
   "maxDuration": 30
  }
 }
}
