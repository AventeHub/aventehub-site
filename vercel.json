{
 "cleanUrls": true,
 "trailingSlash": true,
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    },
    {
     "key": "Permissions-Policy",
     "value": "camera=(), microphone=(), geolocation=()"
    },
    {
     "key": "X-Frame-Options",
     "value": "SAMEORIGIN"
    }
   ]
  },
  {
   "source": "/(.*)/m/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  },
  {
   "source": "/media/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  }
 ],
 "functions": {
  "api/wa-media.js": {
   "maxDuration": 60
  },
  "api/wa-upload.js": {
   "maxDuration": 60
  },
  "api/wa-webhook.js": {
   "maxDuration": 30
  },
  "api/wa-outbox.js": {
   "maxDuration": 30
  },
  "api/social-post.js": {
   "maxDuration": 60
  }
 },
 "crons": [
  {
   "path": "/api/social-post/",
   "schedule": "10 13 * * *"
  },
  {
   "path": "/api/social-post/",
   "schedule": "40 13 * * *"
  },
  {
   "path": "/api/social-post/",
   "schedule": "10 16 * * *"
  },
  {
   "path": "/api/social-post/",
   "schedule": "40 16 * * *"
  },
  {
   "path": "/api/social-post/",
   "schedule": "10 22 * * *"
  },
  {
   "path": "/api/social-post/",
   "schedule": "40 22 * * *"
  }
 ],
 "rewrites": [
  {
   "source": "/social/media/:file*",
   "destination": "https://cdn.jsdelivr.net/gh/AventeHub/aventehub-site@main/social/media/:file*"
  },
  {
   "source": "/media/:file*",
   "destination": "https://cdn.jsdelivr.net/gh/AventeHub/aventehub-site@main/media/:file*"
  },
  {
   "source": "/:dir/m/:file*",
   "destination": "https://cdn.jsdelivr.net/gh/AventeHub/aventehub-site@main/:dir/m/:file*"
  }
 ]
}
